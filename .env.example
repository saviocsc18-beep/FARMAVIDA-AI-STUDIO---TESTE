# =====================================================================
# FARMAVIDA — ENVIRONMENT CONFIGURATION (.env)
# =====================================================================

# ---------------------------------------------------------------------
# ENVIRONMENT & RUNTIME
# ---------------------------------------------------------------------
# APP_ENV: Runtime stage ('development' | 'staging' | 'production')
APP_ENV=development

# ORGANIZATION & STORE MULTI-TENANT ROOTS
ORGANIZATION_ID=org_farmavida
DEFAULT_STORE_ID=store_matriz

# ---------------------------------------------------------------------
# SECURITY & SESSIONS
# ---------------------------------------------------------------------
# JWT_SECRET: Strong secret key (min 32 characters for production)
JWT_SECRET=your_super_secret_jwt_master_key_32_chars_long

# ALLOW_DEV_FALLBACK: When true, allows header-based dev fallback if no token
ALLOW_DEV_FALLBACK=false

# ---------------------------------------------------------------------
# GOOGLE CLOUD & FIREBASE (SERVER-SIDE & CLIENT)
# ---------------------------------------------------------------------
# FIREBASE_PROJECT_ID: The official GCP/Firebase project ID
FIREBASE_PROJECT_ID=your-production-firebase-project-id

# FIREBASE_API_KEY: Web API key for the Firebase project
FIREBASE_API_KEY=AIzaSy...

# FIREBASE_AUTH_DOMAIN: Firebase auth domain (e.g. project-id.firebaseapp.com)
FIREBASE_AUTH_DOMAIN=your-production-firebase-project-id.firebaseapp.com

# FIREBASE_DATABASE_ID: Firestore database instance (e.g. '(default)')
FIREBASE_DATABASE_ID=(default)

# FIREBASE_STORAGE_BUCKET: Firebase storage bucket
FIREBASE_STORAGE_BUCKET=your-production-firebase-project-id.firebasestorage.app

# FIREBASE_APP_ID: Web App ID from Firebase Console
FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# FIREBASE_MESSAGING_SENDER_ID: Cloud messaging sender ID
FIREBASE_MESSAGING_SENDER_ID=1234567890

# ---------------------------------------------------------------------
# PRODUCTION FAIL-SAFE ENVIRONMENT GUARD
# ---------------------------------------------------------------------
# EXPECTED_FIREBASE_PROJECT_ID: When set, verifies that the runtime connects ONLY to this specific project
EXPECTED_FIREBASE_PROJECT_ID=

# ---------------------------------------------------------------------
# AI & INTELLIGENCE
# ---------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini AI API key for intelligence reports
GEMINI_API_KEY=

# ---------------------------------------------------------------------
# VITE CLIENT-SIDE EXPOSURE (Optional override if running outside proxy)
# ---------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
VITE_API_BASE_URL=
